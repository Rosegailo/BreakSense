{
  "expo": {
    "name": "BreakSense",
    "slug": "breaksense",
    "scheme": "breaksense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./img/app_logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./img/app_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f141e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.breaksense",
      "supportsTablet": true
    },
    "android": {
      "package": "com.breaksense",
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "0c4decb7-b77e-460c-805c-4cd82b4ac3b4"
      }
    }
  }
}
